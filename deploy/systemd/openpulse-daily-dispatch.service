[Unit]
Description=Dispatch and verify the daily OpenPulse publication
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/workspace/openpulse-daily
Environment=HOME=/root
Environment=GH_CONFIG_DIR=/root/.config/gh
Environment=GH_PROMPT_DISABLED=1
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=XDG_CACHE_HOME=/var/cache/openpulse-daily
RuntimeDirectory=openpulse-daily
RuntimeDirectoryMode=0750
CacheDirectory=openpulse-daily
CacheDirectoryMode=0700
ExecStart=/usr/bin/flock --nonblock --exclusive /run/openpulse-daily/dispatch.lock /usr/bin/python3 /root/workspace/openpulse-daily/scripts/dispatch_daily.py
TimeoutStartSec=25min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/openpulse-daily /var/cache/openpulse-daily
